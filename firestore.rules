rules_version = '2';

// ShopPal: a household is shared by everyone whose anonymous uid is in its
// `members` map. The household code (the document id) is the only "secret";
// it can be looked up directly but households can never be listed.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isMember(code) {
      return signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/households/$(code)).data.members;
    }

    match /households/{code} {
      // Needed to join: whoever knows the code may read that one document.
      allow get: if signedIn();
      allow list: if false;

      // Creating: only with yourself as the single member.
      allow create: if signedIn()
        && request.resource.data.members.keys().hasOnly([request.auth.uid]);

      // Members may change anything (rename, shopping status, leave).
      // Non-members may only add themselves to `members` (joining with the code).
      allow update: if signedIn() && (
        request.auth.uid in resource.data.members
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
          && request.resource.data.members.diff(resource.data.members).affectedKeys().hasOnly([request.auth.uid])
          && request.auth.uid in request.resource.data.members
        )
      );

      allow delete: if signedIn() && request.auth.uid in resource.data.members;

      // Lists, items and purchase history: members only.
      match /{sub}/{docId} {
        allow read, write: if isMember(code);
      }
    }
  }
}
